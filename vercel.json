{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/lancamento/", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)\\.jpg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
